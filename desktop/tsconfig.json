{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@ferry/ui/*": ["../ui/src/*"],
      "@/*": ["../ui/src/*"],
      "@bindings/*": ["../bindings/*"]
    },
    "baseUrl": "."
  },
  "include": ["src"]
}
