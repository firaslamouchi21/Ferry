{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ferry",
  "version": "1.0.0",
  "identifier": "dev.ferry.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "pnpm --filter @ferry/desktop stage-daemon --profile debug && pnpm --filter @ferry/desktop dev",
    "beforeBuildCommand": "pnpm --filter @ferry/desktop stage-daemon && pnpm --filter @ferry/ui build && pnpm --filter @ferry/desktop build"
  },
  "app": {
    "windows": [
      {
        "title": "Ferry",
        "width": 1180,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    },
    "trayIcon": {
      "id": "ferry-tray",
      "iconPath": "icons/icon.png",
      "tooltip": "Ferry"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "rpm",
      "dmg",
      "app",
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/ferry-daemon"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  },
  "mainBinaryName": "ferry-desktop"
}
